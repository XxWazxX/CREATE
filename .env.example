# ─── Public (inlined in the browser bundle at build time) ───────────────────
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public URL of the deployed app, used in emailed links
# (e.g. https://create.<account>.workers.dev or https://beats.mydomain.com).
NEXT_PUBLIC_APP_URL=

# ─── Server only (secrets — never in GitHub, never in client code) ──────────
# Supabase → Project Settings → API → service_role / secret key.
# Used for automatic owner sign-in and public /p/{token} pages.
SUPABASE_SERVICE_ROLE_KEY=
# The app signs in as this account automatically (created on first run).
OWNER_EMAIL=
# Device access code for the private app (asked once per device). Leave empty
# only for local use — online, without it the private app is open to anyone.
APP_ACCESS_CODE=

# Resend → API Keys
RESEND_API_KEY=
# Sender on a domain verified in Resend (e.g. beats@mydomain.com)
RESEND_FROM_EMAIL=
